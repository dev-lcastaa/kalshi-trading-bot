# Kalshi API credentials (see https://kalshi.com/account/profile)
KALSHI_KEY_ID=your-api-key-id
KALSHI_PRIVATE_KEY_PATH=./.secrets/kalshi_private_key.pem

# "demo" or "prod" - must match the account the key above was generated on
KALSHI_ENV=demo

# CF Benchmarks index IDs to track (settlement source for Kalshi crypto markets)
KALSHI_INDEX_IDS=BRTI,SOLUSD_RTI

# Comma-separated coin tags used to find the 15-min series (case-insensitive)
KALSHI_COIN_TICKS=BTC,SOL

# How often (seconds) to recompute features/predictions/signals
KALSHI_POLL_INTERVAL_SEC=2

# Minimum |model_p - market_p| to flag a signal
KALSHI_EDGE_THRESHOLD=0.05

# First-run default entry rule; dashboard rules are then saved in the database.
# Dollar amounts per trade, not percentages. Budget at most $25.
# Take profit / stop loss of 0 = off (hold to settlement).
KALSHI_TRADE_BUDGET_USD=1.00
KALSHI_TAKE_PROFIT_USD=0
KALSHI_STOP_LOSS_USD=0
# Pause new bets (practice and real) for the rest of the UTC day once that
# day's finished bets have lost this many dollars. 0 = off.
KALSHI_DAILY_LOSS_LIMIT_USD=0

# Decision model: fair-value (default; coin price vs strike blended with the
# market price, falls back to market-recal without ~30 min of index history),
# market-recal, or legacy. The recalibrator activates after
# KALSHI_MARKET_RECAL_MIN_SAMPLES clean settled decisions.
# KALSHI_DECISION_MODEL=fair-value
# KALSHI_MARKET_RECAL_MIN_SAMPLES=300
# KALSHI_MARKET_RECAL_EDGE_THRESHOLD=0
# KALSHI_CONFIRMATION_GATE=false

# Authorizes real-money order execution for the Live mode; the bot still starts
# paused until you enable it in the Trading tab. Paper trading never needs this.
# Dashboard controls have no login: anyone who can reach the dashboard can
# change settings and enable live trading. Keep it on your private network.
KALSHI_ORDER_EXECUTION_ENABLED=false

# "v1" (plain GBM) or "v2" (settlement-window-aware + OLS momentum + book imbalance)
KALSHI_PREDICTOR_VERSION=v2

# How long (seconds) a closed market stays visible on the Active dashboard view
KALSHI_CLOSED_GRACE_SEC=10

# Seconds-before-close at which the one-shot, locked-in trade call is made
# (must be early enough to actually act on before the market closes)
KALSHI_DECISION_LEAD_SEC=390

# Local llama.cpp risk-review service. The T-6:30 review gates the official
# call; the T-2:30 review is informational only. Leave the model blank to
# discover /v1/models.
KALSHI_LLM_BASE_URL=http://192.168.1.229:8080
KALSHI_LLM_MODEL=
KALSHI_LLM_TIMEOUT_SEC=15

# Minimum dollar size of a single fill to be flagged as a "big bet" (see the
# 🐋 Big bets toggle on each market card). Kalshi's trade feed is anonymous -
# this surfaces large trade sizes only, never who made them.
KALSHI_WHALE_MIN_USD=100

# How often (seconds) to check for new big bets on each open market
KALSHI_WHALE_POLL_INTERVAL_SEC=20

# A plain path uses SQLite (local/no-Docker runs); a postgresql:// URL uses Postgres.
# docker-compose.yml sets this to postgresql://kalshi:kalshi@postgres:5432/kalshi
DATABASE_URL=./data/kalshi_bot.db

# Dashboard bind address
KALSHI_DASHBOARD_HOST=127.0.0.1
KALSHI_DASHBOARD_PORT=8000

# Discord notifications (optional, two separate channels). Create a webhook per channel in
# Discord: Channel Settings > Integrations > Webhooks. In production these come from the Jenkins
# credential store (see Jenkinsfile); set them here only for local runs. Paper trades are announced
# too (titled PAPER) unless DISCORD_NOTIFY_PAPER=false.
# DISCORD_TRADE_WEBHOOK_URL=      # a real-money buy was filled
# DISCORD_SETTLEMENT_WEBHOOK_URL= # a position closed (settled or exited) with its P&L
