# Kalshi API credentials (see https://kalshi.com/account/profile)
KALSHI_KEY_ID=your-api-key-id
KALSHI_PRIVATE_KEY_PATH=./.secrets/kalshi_private_key.pem

# "demo" or "prod" - must match the account the key above was generated on
KALSHI_ENV=demo

# CF Benchmarks index IDs to track (settlement source for Kalshi crypto markets)
KALSHI_INDEX_IDS=BRTI,SOLUSD_RTI

# Comma-separated coin tags used to find the 15-min series (case-insensitive)
KALSHI_COIN_TICKS=BTC,SOL

# How often (seconds) to recompute features/predictions/signals
KALSHI_POLL_INTERVAL_SEC=30

# Minimum |model_p - market_p| to flag a signal
KALSHI_EDGE_THRESHOLD=0.05

# "v1" (plain GBM) or "v2" (settlement-window-aware + OLS momentum + book imbalance)
KALSHI_PREDICTOR_VERSION=v2

# How long (seconds) a closed market stays visible on the Active dashboard view
KALSHI_CLOSED_GRACE_SEC=10

# Seconds-before-close at which the one-shot, locked-in trade call is made
# (must be early enough to actually act on before the market closes)
KALSHI_DECISION_LEAD_SEC=390

# Local llama.cpp risk-review service. It reviews the live call at T-6:30 and
# again at T-2:30; a valid BLOCK at T-6:30 changes the live recommendation to
# NO TRADE. Leave the model blank to let the server discover /v1/models.
KALSHI_LLM_BASE_URL=http://192.168.1.229:8080
KALSHI_LLM_MODEL=
KALSHI_LLM_TIMEOUT_SEC=15

# Minimum dollar size of a single fill to be flagged as a "big bet" (see the
# 🐋 Big bets toggle on each market card). Kalshi's trade feed is anonymous -
# this surfaces large trade sizes only, never who made them.
KALSHI_WHALE_MIN_USD=100

# How often (seconds) to check for new big bets on each open market
KALSHI_WHALE_POLL_INTERVAL_SEC=20

# A plain path uses SQLite (local/no-Docker runs); a postgresql:// URL uses Postgres.
# docker-compose.yml sets this to postgresql://kalshi:kalshi@postgres:5432/kalshi
DATABASE_URL=./data/kalshi_bot.db

# Dashboard bind address
KALSHI_DASHBOARD_HOST=127.0.0.1
KALSHI_DASHBOARD_PORT=8000
